#!/bin/sh
set -eu

branch=$(git symbolic-ref --quiet --short HEAD) || {
    echo "Switch to codex/dev before committing (detached HEAD is not a development branch)." >&2
    exit 1
}
case "$branch" in
    main|master)
        echo "Direct commits to $branch are blocked. Use git switch codex/dev, then create or update the stage PR." >&2
        exit 1
        ;;
esac
