#!/bin/sh
set -eu

# Check the destination ref, including explicit refspecs such as HEAD:main.
while read -r local_ref local_oid remote_ref remote_oid; do
    case "$remote_ref" in
        refs/heads/main|refs/heads/master)
            echo "Direct pushes to $remote_ref are blocked. Push a task branch and open a PR." >&2
            exit 1
            ;;
    esac
done
